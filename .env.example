# SentinelFlow environment configuration. Copy to .env and adjust.
# Never commit a real .env file.

ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL (docker-compose overrides the host with the "postgres" service name)
DATABASE_URL=postgresql+psycopg://sentinelflow:sentinelflow_dev@localhost:5433/sentinelflow

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-generate-a-long-random-string
JWT_EXPIRE_MINUTES=480

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# Ollama AI Investigator (advisory only; core risk detection never depends on it)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_FALLBACK_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=120

# Synthetic data environment. Seeded demo accounts all use this password.
SEED_USER_PASSWORD=SentinelDemo#2026
DATA_AS_OF=2026-10-07T23:59:59

# Rate limiting (requests per minute per client)
RATE_LIMIT_PER_MINUTE=240
LOGIN_RATE_LIMIT_PER_MINUTE=10

# Frontend -> backend proxy target (server-side, used by Next.js rewrites)
BACKEND_INTERNAL_URL=http://localhost:8000
